---
import Article from '$/components/Article.astro';
import MainLayout from '$/layouts/MainLayout.astro';
import { formatDate, getSortedBlogPosts } from '$/lib/blog';

const [latest] = await getSortedBlogPosts();
---

<MainLayout>
	<Article title="hi, i'm mistake">
		<p>
			Hello! I'm Mistake, a Persona fan (#1 Akechi defender), & TTRPG enjoyer. I
			started T 10/1/21 and got top surgery 6/19/24. My pronouns are He/It, and
			im a big fat queer. I am genderfaun, polyamorous, and <a
				href="https://mocha8686.neocities.org/">(partnered).</a
			>
		</p>
		<p>
			I GRADUATED with my degree in Business Analytics!! (top of my class
			apparently??) and now I work a real big kid job in tech. I finally wrote <a
				href="/blog/post/my-work-so-far/">the job blog</a
			> (it's basically a novel). I am quite easy to please, so in my free time I
			play video games (Persona 5 Royal is my favorite), draw dumb fanart, and hang
			out with my friends. I also love to write, especially worldbuilding and lore
			for TTRPGs. On occasion I will watch anime, or read queer fiction novels. Honestly
			this is all I need to be happy in life :3
		</p>
		<p><a href="/library/">more about me in the library &gt;&gt;</a></p>
	</Article>

	<Article title="right now">
		<ul class="now-list">
			<li>
				<b>playing</b> THE FINALS, Marvel Rivals, FFXIV, Metaphor: ReFantazio
			</li>
			<li><b>watching</b> Steins;Gate 0 (still...)</li>
			<li><b>reading</b> Superfish (webtoon)</li>
		</ul>
		<p class="updated">last updated October 2026</p>
	</Article>

	{
		latest && (
			<Article title="latest blog">
				<h3>{latest.data.title}</h3>
				<time datetime={latest.data.date.toISOString()}>
					{formatDate(latest.data.date)}
				</time>
				<p>{(latest.body?.substring(0, 200) ?? '') + '...'}</p>
				<a href={`/blog/post/${latest.id}/`}>Read more...</a>
			</Article>
		)
	}
</MainLayout>

<style>
	.now-list {
		margin: 0;
		padding-inline-start: 15px;

		b {
			margin-inline-end: 6px;
			font-size: 15px;
			color: var(--article-heading-color);
			text-transform: uppercase;
		}
	}

	.updated {
		font-size: 13px;
		filter: brightness(60%);
	}
</style>
