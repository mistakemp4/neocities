---
import temp from '$/assets/akechi1.jpg';
import ProfileItem from '$/components/ProfileItem.astro';
import Section from '$/components/Section.astro';
import MainLayout from '$/layouts/MainLayout.astro';

const characters = [
	{ name: 'Akechi 1', image: temp },
	{ name: 'Akechi 2', image: temp },
	{ name: 'Akechi 3', image: temp },
];

const foods = [
	{ name: 'Food 1', image: temp },
	{ name: 'Food 2', image: temp },
	{ name: 'Food 3', image: temp },
];

const books = [
	{ name: 'Book 1', image: temp },
	{ name: 'Book 2', image: temp },
	{ name: 'Book 3', image: temp },
];

const anime = [
	{
		name: 'Anime 1',
		status: 'Completed',
		thoughts: 'Great show!',
		image: temp,
	},
	{
		name: 'Anime 2',
		status: 'In Progress',
		thoughts: 'Enjoying it so far.',
		image: temp,
	},
	{
		name: 'Anime 3',
		status: 'Not Started',
		thoughts: 'Looking forward to watching this.',
		image: temp,
	},
];

const games = [
	{ name: 'Game 1', status: 'Completed', thoughts: 'Great game!', image: temp },
	{
		name: 'Game 2',
		status: 'In Progress',
		thoughts: 'Enjoying it so far.',
		image: temp,
	},
	{
		name: 'Game 3',
		status: 'Not Started',
		thoughts: 'Looking forward to playing this.',
		image: temp,
	},
];
---

<MainLayout>
	<div class="container" x-data>
		<Section title="The mind palace">
			<h2>My favorite characters</h2>
			<ul class="profile-list">
				{
					characters.map(({ name, image }) => (
						<ProfileItem title={name} {image} />
					))
				}
			</ul>
			<h2>My favorite foods</h2>
			<ul class="profile-list">
				{foods.map(({ name, image }) => <ProfileItem title={name} {image} />)}
			</ul>
			<h2>My favorite numbers</h2>
			<p>List of favorite numbers goes here.</p>
		</Section>
		<Section title="Media log">
			<h2>Books I've read</h2>
			<ul class="profile-list">
				{books.map(({ name, image }) => <ProfileItem title={name} {image} />)}
			</ul>
			<h2>Anime I've watched</h2>
			<ul class="profile-list">
				{
					anime.map(({ name, status, thoughts, image }) => (
						<ProfileItem title={name} {image}>
							<h3>{name}</h3>
							<p>Status: {status}</p>
							<p>Thoughts: {thoughts}</p>
						</ProfileItem>
					))
				}
			</ul>
			<h2>Games I've played</h2>
			<ul class="profile-list">
				{
					games.map(({ name, status, thoughts, image }) => (
						<ProfileItem title={name} {image}>
							<h3>{name}</h3>
							<p>Status: {status}</p>
							<p>Thoughts: {thoughts}</p>
						</ProfileItem>
					))
				}
			</ul>
		</Section>
		<Section title="Web Quizzes" class="quiz">
			<a href="https://swiftyshq.neocities.org/fun/quiz/eon">
				<img
					src="https://swiftyshq.neocities.org/img/quiz/eon/vee4.png"
					alt="umbreon"
					title="timid and introverted, you tend to keep to yourself"
				/>
			</a>
			<a href="https://andou.gay/quiz/donutquiz">
				<img src="https://andou.gay/quiz/pinkdonut.png" />
			</a>
			<a href="http://cupped-expressions.net/cheese/quiz/">
				<img
					src="https://files.catbox.moe/9tricg.gif"
					width="226"
					height="93"
					alt="I am american cheese!"
				/>
			</a>
			<a
				href="https://theotaku.com/quizzes/view/4097/what_dere_type_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/4097_Dandere.jpg"
					alt="What Dere Type Are You?"
				/>
			</a>
			<a
				href="https://theotaku.com/quizzes/view/2570/what_neon_genesis_evangelion_character_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/2570_Shinji.jpg"
					alt="What Neon Genesis Evangelion Character Are You?"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/3913/which_hatsune_miku_nendoroid_model_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/3913_Candy_Corn_Miku.jpg"
					alt="Which Hatsune Miku Nendoroid Model Are You?"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/2957/my_little_pony_personality_test%21"
			>
				<img
					src="http://www.theotaku.com/guru_results/2957_Flutterhsy.jpg"
					alt="My Little Pony Personality Test!"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/3743/what_anime_hair_color_best_suits_your_personality%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/3743_Red_Hair.jpg"
					alt="What Anime Hair Color Best Suits Your Personality?"
				/>
			</a>
			<a
				href="https://theotaku.com/quizzes/view/4017/what_undertale_character_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/4017_Dr_Alphys.jpg"
					alt="What Undertale Character Are you?"
				/>
			</a>
		</Section>
		<Section title="Site Graphics">
			<p>
				Here is a collection of all the graphics I have made. Feel free to use
				them with or without credit.
			</p>
		</Section>
		<div
			class="tooltip"
			id="tooltip"
			x-show="$store.tooltip.show"
			x-text="$store.tooltip.value"
			x-on:mousemove.passive.document.throttle.33ms="$store.tooltip.move"
		>
		</div>
	</div>
</MainLayout>

<script>
	import Alpine from 'alpinejs';

	const tooltipElement = document.getElementById('tooltip') as HTMLDivElement;

	const tooltip = {
		show: false,
		value: '',

		set(value: string) {
			this.value = value;
			this.show = true;
		},

		move(e: MouseEvent) {
			const padding = 8;
			tooltipElement.style.setProperty(
				'translate',
				`${e.x + padding}px calc(${e.y - padding}px - 100%)`,
			);
		},

		hide() {
			this.show = false;
		},
	};

	Alpine.store('tooltip', tooltip);
</script>

<style>
	.profile-list {
		--card-size: 100px;

		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(var(--card-size), 100%), auto)
		);
		gap: 1rem;
		list-style: none;
	}

	.tooltip {
		pointer-events: none;

		position: fixed;
		inset-block-start: 0;
		inset-inline-start: 0;

		border: 2px solid red;

		font-size: 1.15rem;

		background: #f00a;
	}

	.container {
		display: contents;
	}
</style>
