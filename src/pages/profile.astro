	</p>
		</Section>
		<div
			class="tooltip"
			id="tooltip"
			x-show="$store.tooltip.show"
			x-text="$store.tooltip.value"
			x-on:mousemove.passive.document.throttle.33ms="$store.tooltip.move"
		>
		</div>
	</div>
</MainLayout>

<script>
	import Alpine from 'alpinejs';

	const tooltipElement = document.getElementById('tooltip') as HTMLDivElement;

	const tooltip = {
		show: false,
		value: '',

		set(value: string) {
			this.value = value;
			this.show = true;
		},

		move(e: MouseEvent) {
			const padding = 8;
			tooltipElement.style.setProperty(
				'translate',
				`${e.x + padding}px calc(${e.y - padding}px - 100%)`,
			);
		},

		hide() {
			this.show = false;
		},
	};

	Alpine.store('tooltip', tooltip);
</script>

<style>
	.tooltip {
		pointer-events: none;

		position: fixed;
		inset-block-start: 0;
		inset-inline-start: 0;

		border: 2px dotted red;

		font-size: 1.15rem;
		font-color: white;

		z-index: 1000;
		padding: 5px 10px;

		background: rgb(43, 0, 0);
	}

	.container {
		display: contents;
	}

	.quiz {
		max-height: 200px;
		overflow: auto;
	}
</style>
