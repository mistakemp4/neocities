---
import { Image } from 'astro:assets';

import temp from '$/assets/akechi1.jpg';
import Section from '$/components/Section.astro';
import MainLayout from '$/layouts/MainLayout.astro';

const IMAGE_SIZE = 100;

const games = [
	{ name: 'Game 1', status: 'Completed', thoughts: 'Great game!', image: temp },
	{
		name: 'Game 2',
		status: 'In Progress',
		thoughts: 'Enjoying it so far.',
		image: temp,
	},
	{
		name: 'Game 3',
		status: 'Not Started',
		thoughts: 'Looking forward to playing this.',
		image: temp,
	},
];
---

<MainLayout>
	<div class="container" x-data>
		<Section title="The mind palace">
			<h2>My favorite characters</h2>
			<p>List of favorite characters goes here. Icons with names below them.</p>
			<h2>My favorite foods</h2>
			<p>List of favorite foods goes here.</p>
			<h2>My favorite numbers</h2>
			<p>List of favorite numbers goes here.</p>
		</Section>
		<Section title="Media log">
			<h2>Books I've read</h2>
			<p>List of books go here. Icons with names below them.</p>
			<h2>Anime I've watched</h2>
			<p>List of anime go here.</p>
			<h2>Games I've played</h2>
			<ul class="media-list">
				{
					games.map(game => (
						<li
							x-on:mouseenter={`$store.tooltip.set('${game.name}')`}
							x-on:mouseleave="$store.tooltip.hide()"
						>
							<Image
								src={game.image}
								alt={game.name}
								layout="constrained"
								width={IMAGE_SIZE}
								height={IMAGE_SIZE}
							/>
							<h3>{game.name}</h3>
							<p>Status: {game.status}</p>
							<p>Thoughts: {game.thoughts}</p>
						</li>
					))
				}
			</ul>
		</Section>
		<Section title="Web Quizzes" class="quiz">
			<a href="https://swiftyshq.neocities.org/fun/quiz/eon"
				><img
					src="https://swiftyshq.neocities.org/img/quiz/eon/vee4.png"
					alt="umbreon"
					title="timid and introverted, you tend to keep to yourself"
				/></a
			>
		</Section>
		<Section title="Site Graphics">
			<p>
				Here is a collection of all the graphics I have made. Feel free to use
				them with or without credit.
			</p>
		</Section>
		<div
			class="tooltip"
			id="tooltip"
			x-show="$store.tooltip.show"
			x-text="$store.tooltip.value"
			x-on:mousemove.passive.document.throttle.33ms="$store.tooltip.move"
		>
		</div>
	</div>
</MainLayout>

<script>
	import Alpine from 'alpinejs';

	const tooltipElement = document.getElementById('tooltip') as HTMLDivElement;

	const tooltip = {
		show: false,
		value: '',

		set(value: string) {
			this.value = value;
			this.show = true;
		},

		move(e: MouseEvent) {
			const padding = 8;
			tooltipElement.style.setProperty(
				'translate',
				`${e.x + padding}px calc(${e.y - padding}px - 100%)`,
			);
		},

		hide() {
			this.show = false;
		},
	};

	Alpine.store('tooltip', tooltip);
</script>

<style>
	.media-list {
		--card-size: 100px;

		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(var(--card-size), 100%), auto)
		);
		gap: 1rem;
		list-style: none;

		> * {
			outline: 1px solid red;
		}
	}

	.tooltip {
		pointer-events: none;

		position: fixed;
		inset-block-start: 0;
		inset-inline-start: 0;

		background: #f00a;
		outline: 2px solid red;
	}

	.container {
		display: contents;
	}
</style>
