---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';
import { render } from 'astro:content';

import BackLink from '$/components/BackLink.astro';
import CommentBox from '$/components/CommentBox.astro';
import Section from '$/components/Section.astro';
import MainLayout from '$/layouts/MainLayout.astro';
import { blogPageFor, getSortedBlogPosts } from '$/lib/blog';

export const getStaticPaths = (async () => {
	const posts = await getSortedBlogPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		props: { post, backHref: `/blog/${blogPageFor(i)}/` },
	}));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post, backHref } = Astro.props;
const { Content } = await render(post);
---

<MainLayout>
	<p><BackLink href={backHref}>back to the blog</BackLink></p>
	<h1>{post.data.title}</h1>
	<div class="content">
		<Content />
	</div>
	<p class="back-row"><BackLink href={backHref}>back to the blog</BackLink></p>
	<Section title="Comments">
		<CommentBox />
	</Section>
</MainLayout>

<style>
	.back-row {
		margin-block: 20px;
	}

	.content :global(p:has(img)) {
		display: grid;
		place-items: center;
	}

	.content :global(img) {
		max-width: 200px;
		max-height: 350px;
	}
	.comment-box {
		margin: 20px 0;
	}
</style>
