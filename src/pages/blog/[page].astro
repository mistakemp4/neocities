---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Article from '$/components/Article.astro';
import MainLayout from '$/layouts/MainLayout.astro';
import { formatDate, getSortedBlogPosts } from '$/lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedBlogPosts();
	return paginate(posts, { pageSize: 3 });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<MainLayout>
	{
		page.data.map(({ data, body, ...post }) => (
			<Article title={data.title}>
				<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
				<p>{(body?.substring(0, 300) ?? '') + '...'}</p>
				<a href={`post/${post.id}`}>Read more...</a>
			</Article>
		))
	}

	<nav>
		<div class="container">
			{
				page.url.first ?
					<a href={page.url.first}>⏮</a>
				:	<a aria-disabled="true">⏮</a>
			}
			{
				page.url.prev ?
					<a href={page.url.prev}>◄</a>
				:	<a aria-disabled="true">◄</a>
			}
			<span>{page.currentPage}</span>
			{
				page.url.next ?
					<a href={page.url.next}>►</a>
				:	<a aria-disabled="true">►</a>
			}
			{
				page.url.last ?
					<a href={page.url.last}>⏭</a>
				:	<a aria-disabled="true">⏭</a>
			}
		</div>
	</nav>
</MainLayout>

<style>
	time {
		font-weight: bold;
	}

	nav {
		display: grid;
		place-items: center;
	}

	.container {
		display: flex;
		gap: 8px;
		justify-content: center;

		margin-block: 8px;
		padding: 8px;
		border: 1px solid var(--darker-border-color);

		font-size: 16px;
		color: var(--article-text-color);

		background-color: var(--article-bg);
	}
</style>
