---
import type { GetStaticPaths, InferGetStaticPropsType } from 'astro';

import Article from '$/components/Article.astro';
import MainLayout from '$/layouts/MainLayout.astro';
import { BLOG_PAGE_SIZE, formatDate, getSortedBlogPosts } from '$/lib/blog';

export const getStaticPaths = (async ({ paginate }) => {
	const posts = await getSortedBlogPosts();
	return paginate(posts, { pageSize: BLOG_PAGE_SIZE });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { page } = Astro.props;
---

<MainLayout>
	{
		page.data.map(({ data, body, ...post }) => (
			<Article title={data.title}>
				<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
				<p>{(body?.substring(0, 300) ?? '') + '...'}</p>
				<a href={`/blog/post/${post.id}/`}>Read more...</a>
			</Article>
		))
	}

	<nav aria-label="blog pages">
		<div class="container">
			<a href={page.url.first} aria-disabled={!page.url.prev}>&lt;&lt; first</a>
			<a href={page.url.prev} aria-disabled={!page.url.prev}>&lt; prev</a>
			<span>page {page.currentPage} of {page.lastPage}</span>
			<a href={page.url.next} aria-disabled={!page.url.next}>next &gt;</a>
			<a href={page.url.last} aria-disabled={!page.url.next}>last &gt;&gt;</a>
		</div>
	</nav>
</MainLayout>

<style>
	time {
		font-weight: bold;
	}

	nav {
		display: grid;
		place-items: center;
	}

	.container {
		display: flex;
		gap: 8px;
		justify-content: center;

		margin-block: 8px;
		padding: 8px;
		border: 1px solid var(--darker-border-color);

		color: var(--article-text-color);

		background-color: var(--article-bg);
	}

	.container {
		flex-wrap: wrap;
		gap: 4px 16px;
		align-items: baseline;
	}

	a {
		text-decoration: none;

		&:hover {
			text-decoration: underline;
		}
	}

	/* dimmed, unclickable on the first/last page */
	a[aria-disabled='true'] {
		pointer-events: none;
		opacity: 0.3;
	}
</style>
