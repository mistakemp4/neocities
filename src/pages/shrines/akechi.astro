---
import { getCollection } from 'astro:content';

import top from '$/assets/akechi1.jpg';
import bottom from '$/assets/akechi2.jpg';
import Base from '$/layouts/Base.astro';

const quotes = (await getCollection('akechi')).map(entry => entry.data.quote);
const quotesString = JSON.stringify(quotes);
---

<Base>
	<header>
		<div class="header-image">
			<img {...top} />
			<p>And so, your heart is always free.</p>
		</div>
		<div class="header-image">
			<img {...bottom} />
			<p>The exact opposite of mine.</p>
		</div>
	</header>

	<div class="gradient"></div>

	<main>
		<section
			class="quotes"
			x-data={`{ quotes: ${quotesString}, current: Math.floor(Math.random() * ${quotes.length}) }`}
		>
			<h2 x-text="quotes[current]"></h2>
			<button @click=`current = Math.floor(Math.random() * ${quotes.length})`
				>⟳</button
			>
		</section>

		<section>
			<h2>Goro Akechi</h2>
			<table>
				<thead>

			<tr>
				<th>Japanese Name</th>
				<th>Also known as</th>
				<th>Contact</th>
				<th>Country</th>
			</tr>
			</thead>
			<tbody>
			<tr>
				<td>明智 吾郎</td>
				<td>
					<p>Crow</p>
					<p>Black Mask</p>
					<p>Second Advent of the Detective Prince</p>
					<p>The Traitor</p>
					<p>Man in the Black Mask</p>
					<p>Mysterious Man</p>
					<p>Pleasant Boy</p>
				</td>
				<td>Maria Anders</td>
				<td>Germany</td>
			</tr>
			</tbody>

			</table>
		</section>
	</main>
</Base>

<style>
	:root {
		--text-color: hsl(23, 95%, 76%);
		--bg-color: #632024;
	}

	:global(body) {
		color: var(--text-color);
		background: black;
	}

	header {
		display: flex;
		flex-direction: column;
		height: 100lvh;
	}

	.header-image {
		position: relative;

		display: grid;
		flex: auto;
		place-items: end;

		padding-inline: 8px;

		p {
			max-width: 50%;
			margin: 0;

			font-size: calc(32px + 2vw);
			font-weight: bold;
			color: red;
			text-shadow: 4px 4px 8px black;
			text-transform: uppercase;
		}

		img {
			position: absolute;
			z-index: -1;
			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: top;
		}

		&:first-child p {
			text-align: right;
		}

		&:last-child {
			justify-items: start;
			background-image: linear-gradient(to bottom, transparent 80%, black);
		}
	}

	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		margin-block: 64px;
	}

	section {
		width: 600px;
		max-width: 600px;
		margin-block: 16px;
		padding: 12px;
		background-color: var(--bg-color);

		img {
			max-width: 100%;
			object-fit: contain;
		}
	}

	button {
		color: inherit;
		background-color: var(--bg-color);
	}

	.quotes {
		width: 100%;
	}

	table {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
	}
</style>
