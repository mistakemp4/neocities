---
import { getCollection } from 'astro:content';

import top from '$/assets/akechi1.jpg';
import bottom from '$/assets/akechi2.jpg';
import Base from '$/layouts/Base.astro';

const quotes = (await getCollection('akechi')).map(entry => entry.data.quote);
const quotesString = JSON.stringify(quotes);
---

<Base>
	<header>
		<div class="header-image">
			<img {...top} />
			<p>And so, your heart is always free.</p>
		</div>
		<div class="header-image">
			<img {...bottom} />
			<p>The exact opposite of mine.</p>
		</div>
	</header>

	<div class="gradient"></div>

	<main>
		<section
			class="quotes"
			x-data={`{ quotes: ${quotesString}, current: Math.floor(Math.random() * ${quotes.length}) }`}
		>
			<h2 class="quote" x-text="quotes[current]"></h2>
			<button @click=`current = Math.floor(Math.random() * ${quotes.length})`
				>⟳</button
			>
		</section>

		<section>
			<h2>Goro Akechi</h2>

			<div class="table">
				<h3><b>Japanese Name</b></h3>
				<div>
					<p>明智 吾郎</p>
				</div>
				<h3><b>Also known as</b></h3>
				<div>
					<p>Crow</p>
					<p>Black Mask</p>
					<p>Second Advent of the Detective Prince</p>
					<p>The Traitor</p>
					<p>Man in the Black Mask</p>
					<p>Mysterious Man</p>
					<p>Pleasant Boy</p>
				</div>
				<h3><b>Occupation</b></h3>
				<div>
					<p>High School Student</p>
					<p>Detective</p>
					<p>Hitman</p>
				</div>
				<h3><b>Affiliation</b></h3>
				<div>
					<p>Tokyo District Special Investigation Department</p>
					<p>Phantom Thieves of Hearts</p>
					<p>Antisocial Force (Enforcer)</p>
				</div>
				<div>
					<h3><b>Date of Birth</b></h3>
				</div>
				<div>
					<p>June 2</p>
				</div>
				<div>
					<h3><b>Age</b></h3>
				</div>
				<div>
					<p>17-18</p>
				</div>
				<div>
					<h3><b>Height</b></h3>
				</div>
				<div>
					<p>178 cm (5'10")</p>
				</div>
				<div>
					<h3><b>Weight</b></h3>
				</div>
				<div>
					<p>64 kg (141 lbs)</p>
				</div>
				<div>
					<h3><b>Blood Type</b></h3>
				</div>
				<div>
					<p>AB</p>
				</div>
				<div>
					<h3><b>Crimes</b></h3>
				</div>
				<div>
					<p>Contract killing</p>
					<p>Terrorism</p>
					<p>Aiding and abetting sedition</p>
					<p>Mass murder</p>
					<p>Incrimination</p>
					<p>Assault and battery</p>
					<p>Manipulation</p>
					<p>Fraud</p>
					<p>Sabotage</p>
					<p>Corruption</p>
					<p>Conspiracy</p>
					<p>Brainwashing</p>
					<p>Kidnapping</p>
					<p>Theft</p>
				</div>
			</div>
		</section>
		<section>
			<a href="https://www.marheavenj.net/akechi/index.php"><img src="/src/assets/fl_icon.jpg" alt="Goro Akechi Fanlisting" /></a>
			<p>Goro Akechi Fanlisting</p>
		</section>


	</main>
</Base>

<style>
	:root {
		--header-color: red;
		--text-color: #f8f8f8;
		--bg-color: #111013;
		--border-color: #9c030b;
	}

	:global(body) {
		color: var(--text-color);
		background: black;
	}

	section {
		border: 2px solid var(--border-color);
	}

	header {
		display: flex;
		flex-direction: column;
		height: 100lvh;
		color: var(--header-color);
	}

	.header-image {
		position: relative;

		display: grid;
		flex: auto;
		place-items: end;

		padding-inline: 8px;

		p {
			margin: 0;

			font-size: calc(32px + 2vw);
			font-weight: bold;
			color: red;
			text-shadow: 4px 4px 8px black;
			text-transform: uppercase;
		}

		img {
			position: absolute;
			z-index: -1;
			inset: 0;

			width: 100%;
			height: 100%;

			object-fit: cover;
			object-position: top;
		}

		&:first-child p {
			text-align: right;
		}

		&:last-child {
			justify-items: start;
			background-image: linear-gradient(to bottom, transparent 80%, black);
		}
	}

	main {
		display: grid;
		grid-template-columns: 1fr;
		margin-block: 64px;

		@media (width >= 600px) {
			grid-template-columns: 1fr 600px 1fr;

			& > * {
				grid-column: 2;
			}
		}

		@media (width >= 1000px) {
			&::before,
			&::after {
				--gradient-cutoff: 50%;

				content: '';
				grid-row: 2;
				opacity: 45%;
			}

			&::before {
				grid-column: 1;
				background:
					linear-gradient(to bottom, transparent var(--gradient-cutoff), black),
					no-repeat center/contain url('/src/assets/akechiside1.webp');
			}

			&::after {
				grid-column: 3;
				background:
					linear-gradient(to bottom, transparent var(--gradient-cutoff), black),
					no-repeat center/contain url('/src/assets/akechiside2.webp');
			}
		}
	}

	section {
		margin-block: 16px;
		padding: 12px;
		background-color: var(--bg-color);
		background-image: linear-gradient(
			to bottom,
			transparent 80%,
			rgb(42, 4, 4)
		);

		img {
			max-width: 100%;
			object-fit: contain;
		}
	}

	button {
		color: inherit;
		background-color: var(--bg-color);
	}

	.quotes {
		text-align: center;
	}

	.quote::before,
	.quote::after {
		display: inline-block;
		margin-inline: 8px;
		font-size: 32px;
		vertical-align: middle;
	}

	.quote::before {
		content: '“';
	}

	.quote::after {
		content: '”';
	}

	.table {
		display: grid;
		grid-template-columns: max-content 1fr;

		& > * {
			margin: -1px;
			padding: 12px;

			&:not(:last-child, :nth-last-child(2)) {
				border-bottom: 2px solid var(--border-color);
			}
		}

		p {
			margin: 0;
		}
	}
</style>
