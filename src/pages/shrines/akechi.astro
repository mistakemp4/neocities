---
import Base from "$/layouts/Base.astro";
import top from "$/assets/akechi1.jpg";
import bottom from "$/assets/akechi2.jpg";

const quotes = [
"I may not seem like it, but I sometimes wish that Santa Claus actually existed.",
"I missed lunch today, so I'm quite hungry myself...",
"Oh, am I mistaken? I thought I heard something about delicious pancakes...",
"It seems I'm unwelcome no matter where I go.",
"...Did I bother you? My apologies.",
"Thanks to him, I was passed from foster home to foster home.",
"Please don't troll me online for this interruption, OK?",
"None of these people know that I was an undesirable child.",
" I wanted people to rely on me... I wanted to be needed...",
"I devoted myself to my studies, acted as an honor student, and made my name as an ace detective.",
"To be honest, I'm envious... I wonder why we couldn't have met a few years earlier.",
"Shut up, shut up, shut up! Teammates!? Friends!? To hell with that! Why am I inferior to you...!?",
"I was extremely particular about my life, my grades, my public image, so someone would want me around!",
"I am an ace detective... a celebrity! But you... You're just some criminal trash living in an attic!",
"How does someone like you have things I don't!? How can such a worthless piece of trash be more special than me!?",
"Don't make me laugh! Justice? Righteous?! Keep that shit to yourselves! You and your teammates piss me off!",
"I will carve my own path for myself... I refuse to accept a reality concocted by someone else, stuck under their control for the rest of my days.",
"I will never accept this form of reality. I'm done being manipulated.",
"Enough of this high-and-mighty bullshit! You're pissing me off!",
"Persona? What's that? Damn, I can't remember...",
"YOU PIECE OF SHIT, I'M GONNA KILL YOU!",
"Why are you... looking at me like that...!? I've... I've succeeded until now... all by myself...! I don't need... teammates... I don't...",
];

const quotesString = JSON.stringify(quotes);
---

<Base>
    <header>
        <div class="header-image">
            <img {...top}>
            <p>And so, your heart is always free.</p>
        </div>
        <div class="header-image">
            <img {...bottom}>
            <p>The exact opposite of mine.</p>
        </div>
    </header>

    <div class="gradient"></div>

<main>

<section class="quotes" x-data={`{ quotes: ${quotesString}, current: Math.floor(Math.random() * ${quotes.length}) }`}>
    <h2 x-text="quotes[current]"></h2>
    <button @click=`current = Math.floor(Math.random() * ${quotes.length})`>⟳</button>
</section>

<section>
    <h2>Hello stinker</h2>
    <p>Testing something one two</p>
    <img {...top}>
</section>

</main>
</Base>

<style>
:global(body) {
    color :white;
    background: black;
}

    header {
        height: 100lvh;
        display: flex;
        flex-direction: column;
    }

    .header-image {
        flex: auto;
        display: grid;
        position: relative;
        place-items: end;
        padding-inline: 8px;
        
    p {
        font-size: calc(32px + 2vw);
        color: red;
        text-transform: uppercase;
        margin: 0;
        font-weight: bold;
        text-shadow: 4px 4px 8px black;
        max-width: 50%;
    }

    img {
        width: 100%;
        height: 100%;
        position: absolute;
        inset: 0;
        object-fit: cover;
        object-position: top;
        z-index: -1;
    }
    
    &:first-child p {
        text-align: right;
    }
    
        &:last-child {
            justify-items: start;
            background-image: linear-gradient(to bottom, transparent 80%, black);
        }
    }

    main {
        margin-block: 64px;
        display: flex; flex-direction: column;
        align-items: center;
    }

    section {
        max-width: 600px;
        border: 2px dotted lime;
        background-color: gray;
        border: 2px solid lightgray;
        padding: 12px;
        margin-block: 16px;

        img {
            max-width: 100%;
            object-fit: contain;
        }
    }

    .quotes {
        width: 100%;
    }
</style>