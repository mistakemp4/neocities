---
import { Image } from 'astro:assets';

import favs from '$/assets/site/rooms/favs.svg';
import graphics from '$/assets/site/rooms/graphics.svg';
import media from '$/assets/site/rooms/media.svg';
import projects from '$/assets/site/rooms/projects.svg';
import quizzes from '$/assets/site/rooms/quizzes.svg';
import shrines from '$/assets/site/rooms/shrines.svg';
import Section from '$/components/Section.astro';
import MainLayout from '$/layouts/MainLayout.astro';

// pixel icons, drawn by scripts/room_icons.py
const rooms = [
	{
		name: 'favs',
		blurb: 'hyperfixations, characters, foods',
		image: favs,
		href: '/library/favs/',
	},
	{
		name: 'media log',
		blurb: 'every game ive played and anime ive watched',
		image: media,
		href: '/library/media/',
	},
	{
		name: 'shrines',
		blurb: 'deep dives on stuff i love',
		image: shrines,
		href: '/shrines/',
	},
	{
		name: 'web quizzes',
		blurb: 'im 99% loser and american cheese apparently',
		image: quizzes,
		href: '/library/quizzes/',
	},
	{
		name: 'site graphics',
		blurb: 'blinkies & stuff i made, free to use',
		image: graphics,
		href: '/library/graphics/',
	},
	{
		name: 'projects',
		blurb: 'little tools & data stuff i made',
		image: projects,
		href: '/library/projects/',
	},
];
---

<MainLayout>
	<Section title="the library">
		<p>welcome to the mind palace's library. pick a room (◕‿◕)</p>
		<div class="rooms">
			{
				rooms.map(room => (
					<a class="room" href={room.href}>
						<Image src={room.image} alt="" height={70} />
						<h3>{room.name}</h3>
						<p>{room.blurb}</p>
					</a>
				))
			}
		</div>
	</Section>
</MainLayout>

<style>
	.rooms {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 10px;
	}

	.room {
		display: flex;
		flex-direction: column;
		align-items: center;

		padding: 10px;
		border: 1px solid var(--darker-border-color);

		color: var(--article-text-color);
		text-align: center;
		text-decoration: none;

		background-color: var(--nav-bg);

		&:hover {
			border-color: var(--nav-link-color);
		}

		h3 {
			margin: 5px 0;
			font-size: 19px;
			text-transform: uppercase;
		}

		p {
			margin: 0;
			font-size: 16px;
		}
	}
</style>
