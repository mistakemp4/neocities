---
import BackLink from '$/components/BackLink.astro';
import Section from '$/components/Section.astro';
import MainLayout from '$/layouts/MainLayout.astro';
---

<MainLayout>
	<p><BackLink href="/library/">back to the library</BackLink></p>
	<Section title="Web Quizzes">
		<div class="quiz-scroll">
			<a href="https://swiftyshq.neocities.org/fun/quiz/eon">
				<img
					src="https://swiftyshq.neocities.org/img/quiz/eon/vee4.png"
					alt="umbreon"
					title="timid and introverted, you tend to keep to yourself"
				/>
			</a>
			<a href="https://andou.gay/quiz/donutquiz">
				<img src="https://andou.gay/quiz/pinkdonut.png" />
			</a>
			<a href="http://cupped-expressions.net/cheese/quiz/">
				<img
					src="https://files.catbox.moe/9tricg.gif"
					width="226"
					height="93"
					alt="I am american cheese!"
				/>
			</a>
			<a href="http://www.nerdtests.com/ft_loser.php?im">
				<img
					src="http://www.nerdtests.com/images/ft/lsr.php?val=3760"
					alt="I am 99% loser. What about you? Click here to find out!"
				/>
			</a>
			<a href="https://clownfred.zone/clownquiz"
				><img
					src="https://clownfred.zone/!Media/CQ/PierrotCard1.png"
					alt="I 	am a Pierrot Mime! Click here to take the clown quiz!"
				/></a
			>

			<a
				href="https://theotaku.com/quizzes/view/4097/what_dere_type_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/4097_Dandere.jpg"
					alt="What Dere Type Are You?"
				/>
			</a>
			<a
				href="https://theotaku.com/quizzes/view/2570/what_neon_genesis_evangelion_character_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/2570_Shinji.jpg"
					alt="What Neon Genesis Evangelion Character Are You?"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/3913/which_hatsune_miku_nendoroid_model_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/3913_Candy_Corn_Miku.jpg"
					alt="Which Hatsune Miku Nendoroid Model Are You?"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/2957/my_little_pony_personality_test%21"
			>
				<img
					src="http://www.theotaku.com/guru_results/2957_Flutterhsy.jpg"
					alt="My Little Pony Personality Test!"
				/>
			</a>
			<a
				href="https://www.theotaku.com/quizzes/view/3743/what_anime_hair_color_best_suits_your_personality%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/3743_Red_Hair.jpg"
					alt="What Anime Hair Color Best Suits Your Personality?"
				/>
			</a>
			<a
				href="https://theotaku.com/quizzes/view/4017/what_undertale_character_are_you%3F"
			>
				<img
					src="http://www.theotaku.com/guru_results/4017_Dr_Alphys.jpg"
					alt="What Undertale Character Are you?"
				/>
			</a>
		</div>
	</Section>
</MainLayout>

<style>
	.quiz-scroll {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		align-items: center;
	}
</style>
