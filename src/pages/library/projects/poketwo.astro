---
import BackLink from '$/components/BackLink.astro';
import Notebook from '$/components/Notebook.astro';
import SpawnLookup from '$/components/SpawnLookup.astro';
import notebook from '$/data/poketwo-notebook.json';
import WriteupLayout from '$/layouts/WriteupLayout.astro';
import { readNotebook } from '$/lib/notebook';

const { title, cells, sections } = readNotebook(notebook);

// the legend lists the tool first, then every section of the notebook
const entries = [{ id: 'tool', text: 'Look one up' }, ...sections];
---

<WriteupLayout
	title="pokétwo spawn odds"
	description="how likely the pokétwo discord bot is to spawn each pokémon, with a lookup tool and my full notebook"
	sections={entries}
	bodyClass="p2-wide"
>
	<p>
		<BackLink href="/library/projects/">back to projects</BackLink>
	</p>

	<section id="tool" class="card" data-section>
		<h2>Pokétwo spawn odds</h2>
		<p>
			i dug through the public data behind the pokétwo discord bot to see how it
			picks what to spawn. it's a weighted random draw, so every pokémon has its
			own odds. type a name or pokédex number
		</p>
		<SpawnLookup />
		<p class="note">
			based on pokétwo's public data. the live bot uses a private copy, so real
			odds may be a little different. messages assume 1 spawn per 24 counted
			messages in a server. sprites are from PokeAPI.
		</p>
	</section>

	<section class="card">
		<h2>{title}</h2>
		<Notebook cells={cells} theme="vesper" />
	</section>
</WriteupLayout>

<style is:global>
	body.p2-wide {
		/* pink and blue from the charts as the accents */
		--p2-card: var(--article-bg);
		--p2-border: var(--darker-border-color);
		--p2-heading: #ff9ecf;
		--p2-text: var(--article-text-color);
		--p2-muted: var(--sidebar-text-color);
		--p2-blue: #8fd0ff;
		--p2-code: var(--nav-bg);
		--p2-surface: var(--bg);
		--p2-radius: 0;
		--p2-radius-sm: 0;
		--p2-pill: 0;
		--p2-line: 1px;
		--p2-result-style: solid;
		--p2-mono: var(--font-pixel);
		--p2-mono-size: 17px;
		--p2-mono-leading: 1.2;
	}
</style>

<style>
	.note {
		margin: 12px 0 0;
		font-size: 14px;
		color: var(--sidebar-text-color);
	}
</style>
