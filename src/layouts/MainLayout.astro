    --nav-bg: #f2f2f2;
    --article-bg: #ededef;
    --border-color: #e0e0e0;
    --sidebar-text-color: #6f7a79;
    --article-text-color: #625f5f;
    --article-heading-color: #929292;
    --nav-link-color: #5f758c;
    --darker-border-color: #c6c6c6;
  }

  a {
    color: var(--nav-link-color);
  }

  .container {
    display: flex;
    max-width: 900px;

    @media only screen and (max-width: 800px) {
