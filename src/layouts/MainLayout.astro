---
import { ClientRouter } from 'astro:transitions';

import Footer from '$/components/Footer.astro';
import Header from '$/components/Header.astro';
import Navbar from '$/components/Navbar.astro';
import Player from '$/components/Player.astro';
import Sidebar from '$/components/Sidebar.astro';
import SidebarLink from '$/components/SidebarLink.astro';
import SidebarLinks from '$/components/SidebarLinks.astro';
import SidebarSection from '$/components/SidebarSection.astro';
import SiteButton from '$/components/SiteButton.astro';
import Sites from '$/components/Sites.astro';
import StatusCafe from '$/components/StatusCafe.astro';
import WebringTrans from '$/components/WebringTrans.astro';
import { formatDate, getSortedBlogPosts } from '$/lib/blog';

import Base from './Base.astro';

const posts = (await getSortedBlogPosts()).slice(0, 3);
---

<ClientRouter />

<Base>
	<Header />
	<Navbar />

	<div class="layout-container">
		<Sidebar>
			<SidebarSection title="Music Player">
				<Player />
			</SidebarSection>
			<SidebarSection title="Blog">
				<SidebarLinks>
					{
						posts.map(post => (
							<SidebarLink class="post-preview" href={`/blog/post/${post.id}/`}>
								<h3>{post.data.title}</h3>
								<time datetime={post.data.date.toISOString()}>
									{formatDate(post.data.date)}
								</time>
							</SidebarLink>
						))
					}
				</SidebarLinks>
			</SidebarSection>
			<SidebarSection title="Where 2 find me">
				<SidebarLinks>
					<SidebarLink href="https://en.pronouns.page/@mistakemp4"
						>pronouns.page</SidebarLink
					>
					<SidebarLink href="https://toyhou.se/mistakemp4"
						>toyhou.se</SidebarLink
					>
					<SidebarLink href="https://artfight.net/~mistakemp4"
						>artfight.net</SidebarLink
					>
					<SidebarLink href="https://steamcommunity.com/id/Mistakemp4/"
						>steam</SidebarLink
					>
					<SidebarLink href="https://myanimelist.net/profile/mistake_mp4/"
						>myanimelist</SidebarLink
					>
				</SidebarLinks>
			</SidebarSection>
		</Sidebar>

		<main>
			<slot />
		</main>

		<Sidebar>
			<SidebarSection title="Status">
				<StatusCafe />
			</SidebarSection>

			<SidebarSection title="Links">
				<Sites />
			</SidebarSection>

			<SidebarSection title="Webrings">
				<WebringTrans />
			</SidebarSection>

			<SidebarSection title="My Button">
				<SiteButton />
			</SidebarSection>
		</Sidebar>
	</div>

	<Footer />
</Base>

<style is:global>
	:root {
		--bg: black;
		--header-bg: #0e0e0e;
		--nav-bg: #0d0d0d;
		--article-bg: #121210;
		--button-bg: #534b4c;
		--border-color: #1f1f1f;
		--sidebar-text-color: #a09697;
		--article-text-color: #adb0b0;
		--article-heading-color: #7d7d7d;
		--nav-link-color: #b09b83;
		--darker-border-color: #393939;
	}

	body {
		color: var(--article-text-color);
		background-color: var(--bg);
	}

	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		color: var(--article-heading-color);
	}

	a {
		color: var(--nav-link-color);
	}

	button {
		color: inherit;
		background-color: var(--button-bg);
	}

	.layout-container {
		display: flex;
		max-width: 900px;

		@media only screen and (max-width: 800px) {
			flex-wrap: wrap;
		}
	}

	main {
		flex: auto;
		margin-inline: 20px;
	}

	.post-preview {
		h3 {
			margin: 0;
			font-size: inherit;
			font-weight: normal;
		}

		time {
			font-size: 10px;
			filter: brightness(60%);
		}
	}
</style>
