---
interface Props {
	title?: string;
}

const { title = 'i love akechi!!' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	body {
		margin: 0;
		padding: 0;
	}

	body {
		font-size: 12px;
	}
</style>
