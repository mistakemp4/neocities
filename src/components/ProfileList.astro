---
interface Props {
itemSize?: number;
gap?: number;
}

const { gap = 5, itemSize = 65 } = Astro.props;
---

<ul x-data>
	<slot />
</ul>

<style define:vars={{ gap: `${gap}px`, 'item-size': `${itemSize}px` }}>
	ul {
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(100%, var(--item-size)), auto)
		);
		gap: var(--gap);

		padding: 0;

		list-style: none;
	}
</style>
