---
import type { HTMLAttributes } from 'astro/types';

type Props = {
itemSize?: number;
gap?: number;
} & HTMLAttributes<'ul'>;

const { gap = 5, itemSize = 65, ...props } = Astro.props;
---

<ul x-data {...props}>
	<slot />
</ul>

<style define:vars={{ gap: `${gap}px`, 'item-size': `${itemSize}px` }}>
	ul {
		display: grid;
		grid-template-columns: repeat(
			auto-fill,
			minmax(min(100%, var(--item-size)), auto)
		);
		gap: var(--gap);

		padding: 0;

		list-style: none;
	}
</style>
