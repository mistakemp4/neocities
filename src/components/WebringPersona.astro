<div class="ring" transition:persist>
	<script is:inline src="https://flonkie.github.io/personaring/mini.setup.js"
	></script>
</div>

<script>
	// ring script puts its styles in <head>, which ClientRouter swaps out; carry them over
	document.addEventListener('astro:before-swap', e => {
		for (const style of document.head.querySelectorAll('style')) {
			if (style.textContent?.includes('[data-pmo-id=')) {
				e.newDocument.head.append(style.cloneNode(true));
			}
		}
	});
</script>

<style is:global>
	#persona-pmoring {
		width: auto;
		margin-block: 12px;

		img {
			display: block;
			max-width: 100%;
			height: auto;
			object-fit: contain;
		}

		/* ring script hardcodes 300px; fit the 150px sidebar */
		.pminicenter {
			width: auto !important;
			max-width: 100%;
		}

		.pminisize {
			height: auto !important;
		}

		.pminimaincard {
			display: initial;
			width: auto;
			height: auto;
		}

		.pminidirections {
			justify-content: space-around;
		}

		.pminisml {
			width: auto;
			font-size: 0.5rem;
		}
	}
</style>
