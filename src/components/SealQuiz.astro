---
import { quiz } from '$/lib/sealquiz';

const data = `{
	questions: ${JSON.stringify(quiz.questions.map(question => ({ answers: question.answers.map(answer => ({ for: answer.for })) })))},
	results: ${JSON.stringify(quiz.results)},
	picked: ${JSON.stringify(quiz.questions.map(() => null))},
	result: null,
	copied: false,

	get answered() {
		return this.picked.filter(pick => pick !== null).length;
	},

	score() {
		const points = {};
		// later questions come first, so they win a tie
		const order = [];
		for (let q = this.questions.length - 1; q >= 0; q--) {
			for (const id of this.questions[q].answers[this.picked[q]].for) {
				points[id] = (points[id] ?? 0) + 1;
				if (!order.includes(id)) order.push(id);
			}
		}
		const best = Math.max(...Object.values(points));
		const winner = order.find(id => points[id] === best);
		this.result = this.results.find(result => result.id === winner);
		this.copied = false;
		this.$nextTick(() => this.$refs.result.scrollIntoView({ block: 'center' }));
	},

	retake() {
		this.picked = this.picked.map(() => null);
		this.result = null;
		this.$el.closest('.seal-quiz').scrollIntoView();
	},

	async copy() {
		await navigator.clipboard.writeText(this.result.embed);
		this.copied = true;
	},
}`;
---

<div class="seal-quiz" x-data={data}>
	<ol class="questions">
		{
			quiz.questions.map((question, q) => (
				<li>
					<fieldset>
						<legend>
							<b>{q + 1}</b>
							<span>{question.text}</span>
						</legend>
						<div class="answers">
							{question.answers.map((answer, a) => (
								<label>
									<input
										type="radio"
										name={`seal-q${q}`}
										value={a}
										x-model.number={`picked[${q}]`}
									/>
									<span class="text">{answer.text}</span>
								</label>
							))}
						</div>
					</fieldset>
				</li>
			))
		}
	</ol>

	<p class="go">
		<button
			type="button"
			x-on:click="score()"
			x-bind:disabled="answered < questions.length">reveal my seal</button
		>
		<small x-text="answered + ' / ' + questions.length + ' answered'"></small>
	</p>

	<template x-if="result">
		<div class="result" x-ref="result" x-bind:style="'--c: ' + result.color">
			<div class="card">
				<img
					x-bind:src="result.badge"
					x-bind:alt="'trading card: ' + result.name"
					width="200"
					height="280"
				/>
			</div>
			<div class="about">
				<h3>you are <span x-text="result.name"></span></h3>
				<p class="tag" x-text="result.tag"></p>
				<p x-text="result.blurb"></p>
				<label for="seal-embed">put it on your site:</label>
				<textarea
					id="seal-embed"
					readonly
					rows="4"
					x-text="result.embed"
					x-on:focus="$el.select()"></textarea>
				<p class="actions">
					<button
						type="button"
						x-on:click="copy()"
						x-text="copied ? 'copied!' : 'copy code'"></button>
					<button type="button" x-on:click="retake()">retake</button>
				</p>
			</div>
		</div>
	</template>
</div>

<style>
	.seal-quiz {
		/* the link blue from the wiki's dark mode */
		--c-accent: #7ea9ff;
	}

	.questions {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	fieldset {
		margin: 0 0 18px;
		padding: 0;
		border: 0;
	}

	legend {
		display: flex;
		gap: 8px;
		align-items: center;

		margin-bottom: 6px;
		padding: 0;

		font-size: 18px;
		color: #fff;

		b {
			padding: 0 8px;
			font-weight: normal;
		}
	}

	.answers {
		display: grid;
		gap: 3px;
	}

	label:has(input) {
		cursor: pointer;

		position: relative;

		display: flex;
		gap: 8px;
		align-items: baseline;

		padding: 2px 8px;

		&:hover {
			z-index: 1;
		}

		&:has(:focus-visible) {
			outline: 2px solid #fff;
		}
	}

	input[type='radio'] {
		flex: none;
		accent-color: #000;
	}

	.text {
		display: inline-block;
	}

	button {
		cursor: pointer;

		padding: 4px 14px;
		border: 1px solid var(--darker-border-color);

		font: inherit;
		font-size: 18px;
		color: #000;

		background-color: var(--c-accent);

		&:hover:not(:disabled) {
			background-color: #fff;
		}

		&:disabled {
			cursor: not-allowed;
			color: var(--sidebar-text-color);
			background-color: var(--nav-bg);
		}
	}

	.go {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		align-items: center;

		small {
			color: var(--sidebar-text-color);
		}
	}

	.result {
		display: flex;
		flex-wrap: wrap;
		gap: 16px;
		align-items: flex-start;

		margin-top: 18px;
		padding: 12px;
		border: 1px solid var(--c);

		background-color: var(--nav-bg);

		h3 {
			margin: 0;
			font-size: 24px;
			color: #fff;

			span {
				color: var(--c);
			}
		}

		.tag {
			margin: 0 0 8px;
			color: var(--c);
		}

		label {
			display: block;
		}

		textarea {
			resize: vertical;

			box-sizing: border-box;
			width: 100%;
			border: 1px solid var(--darker-border-color);

			font: inherit;
			font-size: 14px;
			color: var(--article-text-color);

			background-color: var(--bg);
		}
	}

	.card {
		flex: none;
		max-width: 100%;

		img {
			display: block;
			max-width: 100%;
			height: auto;
		}
	}

	.about {
		flex: 1 1 240px;
		min-width: 0;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
		margin-bottom: 0;
	}

	/* wiki look: heading rules & plain rows */
	.seal-quiz {
		legend {
			width: 100%;
			padding-bottom: 2px;
			border-bottom: 1px solid var(--darker-border-color);
			font-family: Georgia, serif;

			b {
				padding: 0;

				&::after {
					content: '.';
				}
			}
		}

		label:has(input) {
			border-left: 3px solid transparent;

			&:hover .text {
				text-decoration: underline;
			}

			&:has(:checked) {
				border-left-color: var(--c-accent);
				color: #fff;
				background-color: #ffffff0d;
			}
		}

		button {
			border-color: #a2a9b1;
			color: #202122;
			background-color: #f8f9fa;

			&:hover:not(:disabled) {
				background-color: #fff;
			}

			&:disabled {
				color: var(--sidebar-text-color);
				background-color: var(--nav-bg);
			}
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.seal-quiz * {
			transition: none !important;
			animation: none !important;
		}
	}
</style>
