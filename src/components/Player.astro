---
import album from '$/assets/site/album_cover.webp';
import disc from '$/assets/site/disc.webp';

const onclick =
	"() => {const audio = document.getElementById('audio'); if (audio.paused) audio.play(); else audio.pause();}";

// audio persists across pages; only set the default volume once
const init = `
	const audio = document.getElementById('audio');
	if (!audio.dataset.volSet) {
		let saved = null;
		try { saved = localStorage.getItem('player-volume'); } catch {}
		audio.volume = saved === null ? 0.3 : Number(saved);
		audio.dataset.volSet = '1';
	}
	vol = audio.volume;
`;
const oninput = `
	document.getElementById('audio').volume = vol;
	try { localStorage.setItem('player-volume', vol); } catch {}
`;
---

<div x-data="{ vol: 0.3 }" x-init={init}>
	<div class="player" @click={onclick}>
		<img class="img2" src={album.src} />
		<img class="img1" src={disc.src} />
	</div>
	<label class="volume">
		vol
		<input
			type="range"
			min="0"
			max="1"
			step="0.05"
			x-model.number="vol"
			:style="`--fill: ${vol * 100}%`"
			@input={oninput}
		/>
	</label>
</div>
<audio transition:persist id="audio" src="https://files.catbox.moe/sudbyr.flac"
></audio>

<style>
	.player {
		cursor: pointer;
		display: flex;
		align-items: center;
	}

	.img2 {
		z-index: 999;
		/* album's cover image u can change the size! */
		aspect-ratio: 1 / 1;
		max-width: 90px;
	}

	.img1 {
		z-index: 800;
		/* cd image u can change the size too */
		aspect-ratio: 1/1;
		max-width: 75px;
		margin-inline-start: -40px;

		animation: spin 4s linear infinite;
	}

	.volume {
		display: flex;
		gap: 0.5em;
		align-items: center;
		margin-top: 0.5em;
	}

	/* fully custom so no browser/theme colors leak in */
	.volume input {
		--fill: 30%;

		cursor: pointer;

		flex: 1;

		min-width: 0;
		height: 14px;
		margin: 0;

		appearance: none;
		background: transparent;
	}

	.volume input::-webkit-slider-runnable-track {
		height: 4px;
		border: 1px solid var(--darker-border-color);
		background: linear-gradient(
			to right,
			var(--accent-red) var(--fill),
			var(--nav-bg) var(--fill)
		);
	}

	.volume input::-webkit-slider-thumb {
		width: 8px;
		height: 14px;
		margin-top: -6px;
		border: 1px solid var(--darker-border-color);

		appearance: none;
		background: var(--accent-red);
	}

	.volume input::-moz-range-track {
		height: 4px;
		border: 1px solid var(--darker-border-color);
		background: var(--nav-bg);
	}

	.volume input::-moz-range-progress {
		height: 4px;
		background: var(--accent-red);
	}

	.volume input::-moz-range-thumb {
		width: 8px;
		height: 14px;
		border: 1px solid var(--darker-border-color);
		border-radius: 0;

		background: var(--accent-red);
	}

	.volume input:focus-visible {
		outline: 1px solid var(--nav-link-color);
		outline-offset: 2px;
	}

	@keyframes spin {
		100% {
			rotate: 360deg;
		}
	}

	.img1:hover {
		/* this makes the cd stop spinning when hovering */
		-webkit-animation: pop 0.7s ease;
	}
</style>
