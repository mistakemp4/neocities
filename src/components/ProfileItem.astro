---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	// second line of the tooltip
	detail?: string;
	image: ImageMetadata;
	size?: number;
	alt?: string;
	noHover?: boolean;
}

const {
	title,
	detail = '',
	image,
	size = 100,
	alt = detail ? `${title} (${detail})` : title,
	noHover = false,
} = Astro.props;
// JSON.stringify, so an apostrophe in a name can't break the script
const show = `$store.tooltip.set(${JSON.stringify(title)}, ${JSON.stringify(detail)})`;
---

<li
	data-tooltip={!noHover}
	x-on:mouseenter={!noHover && show}
	x-on:mouseleave={!noHover && '$store.tooltip.hide()'}
>
	<Image src={image} {alt} width={size} height={size} layout="constrained" />
	<slot />
</li>
