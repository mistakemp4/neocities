---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	title: string;
	image: ImageMetadata;
	size?: number;
	alt?: string;
	noHover?: boolean;
}

const { title, image, size = 100, alt = title, noHover = false } = Astro.props;
---

<li
	x-on:mouseenter={!noHover && `$store.tooltip.set('${title}')`}
	x-on:mouseleave={!noHover && "$store.tooltip.hide()"}
>
	<Image src={image} {alt} width={size} height={size} layout="constrained" />
	<slot />
</li>
