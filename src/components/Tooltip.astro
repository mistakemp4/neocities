---
const tooltipStore = `
{
	show: false,
	value: '',

	set(value) {
		this.value = value;
		this.show = true;
	},

	move(tooltip, x, y) {
		const padding = 8;
		tooltip.style.setProperty(
			'translate',
			\`\${x + padding}px calc(\${y - padding}px - 100%)\`,
		);
	},

	hide() {
		this.show = false;
	},
}
`
---

<div
	class="tooltip"
	id="tooltip"
	x-data
	x-show="$store.tooltip.show"
	x-text="$store.tooltip.value"
	x-ref="tooltip"
	x-on:mousemove.passive.document.throttle.33ms="$store.tooltip.move($refs.tooltip, $event.x, $event.y)"
	x-init={`Alpine.store('tooltip', ${tooltipStore})`}
>
</div>

<style>
	.tooltip {
		pointer-events: none;

		position: fixed;
		z-index: 1000;
		inset-block-start: 0;
		inset-inline-start: 0;

		padding: 5px 10px;
		border: 2px dotted red;

		font-size: 1.15rem;

		background: rgb(43, 0, 0);

		font-color: white;
	}
</style>
