---
const tooltipStore = `
{
	show: false,
	title: '',
	detail: '',

	set(title, detail = '') {
		this.title = title;
		this.detail = detail;
		this.show = true;
	},

	move(tooltip, { target, x, y }) {
		// safety net: a missed mouseleave can't leave the tooltip stuck
		if (!target.closest?.('[data-tooltip]')) return this.hide();
		const padding = 10;
		// above and right of the mouse, pulled back in at the window's edges
		const left = Math.min(x + padding, innerWidth - tooltip.offsetWidth - 4);
		const top = Math.max(y - padding - tooltip.offsetHeight, 4);
		tooltip.style.setProperty('translate', \`\${Math.max(left, 4)}px \${top}px\`);
	},

	hide() {
		this.show = false;
	},
}
`;
---

<div
	class="tooltip"
	id="tooltip"
	x-data
	x-show="$store.tooltip.show"
	x-cloak
	x-ref="tooltip"
	x-on:mousemove.passive.document.throttle.33ms="$store.tooltip.move($refs.tooltip, $event)"
	x-init={`Alpine.store('tooltip', ${tooltipStore})`}
>
	<b x-text="$store.tooltip.title"></b>
	<span x-show="$store.tooltip.detail" x-text="$store.tooltip.detail"></span>
</div>

<style>
	[x-cloak] {
		display: none;
	}

	/* follows the mouse: name on top, series under it */
	.tooltip {
		pointer-events: none;

		position: fixed;
		z-index: 1000;
		inset-block-start: 0;
		inset-inline-start: 0;

		max-width: 260px;
		padding: 3px 10px 4px;
		border: 1px solid var(--nav-link-color);

		line-height: 1.1;

		background-color: var(--bg);
		box-shadow: 3px 3px 0 var(--accent-red);

		b {
			display: block;
			font-size: 19px;
			font-weight: normal;
			color: #fff;
		}

		span {
			display: block;
			font-size: 15px;
			color: var(--nav-link-color);
		}
	}
</style>
