			s.setAttribute(
				'src',
				h +
					'/jread?page=' +
					encodeURIComponent(l).replace('+', '%2B') +
					'&mod=%241%24wq1rdBcg%24cWbHie66DaznbgSNyUp1p%2F' +
					'&opts=16798&num=10&ts=1778440321174',
			);
