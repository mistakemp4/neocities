---
import NavbarLink from './NavbarLink.astro';
---

<nav>
	<ul>
		<NavbarLink href="/">Home</NavbarLink>
		<NavbarLink href="/blog/1/">Blog</NavbarLink>
		<NavbarLink href="/library/">Library</NavbarLink>
		<NavbarLink href="/about/">About Site</NavbarLink>
		<NavbarLink
			href="https://mistakemp4.atabook.org/"
			rel="noreferrer"
			target="_blank">Guestbook</NavbarLink
		>
	</ul>
</nav>

<style>
	nav {
		height: auto;
		margin-bottom: 10px;
		padding-block: 10px;
		border: 2px solid var(--darker-border-color);
		border-inline-start: none;
		border-inline-end: none;

		text-align: center;

		background-color: var(--nav-bg);
	}

	ul {
		display: contents;
	}

	@media (width <= 800px) {
		nav {
			padding-inline: 10px;
		}

		ul {
			display: flex;
			flex-wrap: wrap;
			gap: 4px 20px;
			justify-content: center;

			margin: 0;
			padding: 0;
		}

		ul :global(li) {
			padding-inline: 0;
		}
	}
</style>
