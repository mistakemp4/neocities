---
import { formatDate, getSortedBlogPosts } from '$/lib/blog';
import { buildSitemap, type SitemapNode } from '$/lib/sitemap';

interface Props {
	// set by the component itself for nested levels
	nodes?: SitemapNode[];
}

const { nodes } = Astro.props;
const list = nodes ?? [buildSitemap()];
const posts = list.some(node => node.posts) ? await getSortedBlogPosts() : [];
---

<ul class={nodes ? undefined : 'tree'}>
	{
		list.map(node => (
			<li>
				<a href={node.href} rel={node.external ? 'noreferrer' : undefined}>
					{node.label}
				</a>
				{node.note && ` (${node.note})`}
				{node.posts && (
					<details>
						<summary>{posts.length} posts</summary>
						<ul>
							{posts.map(post => (
								<li>
									<a href={`/blog/post/${post.id}/`}>{post.data.title}</a>{' '}
									<time datetime={post.data.date.toISOString()}>
										{formatDate(post.data.date)}
									</time>
								</li>
							))}
						</ul>
					</details>
				)}
				{node.children.length > 0 && <Astro.self nodes={node.children} />}
			</li>
		))
	}
</ul>

<style>
	/* text tree: each li draws its own ├── / └── branch */
	.tree,
	.tree ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tree ul {
		margin-inline-start: 0.5em;
	}

	.tree ul li {
		position: relative;
		padding-inline-start: 1.5em;
		border-inline-start: 1px solid var(--article-heading-color);
	}

	.tree ul li:last-child {
		border-inline-start-color: transparent;
	}

	.tree ul li::before {
		content: '';

		position: absolute;
		top: 0;
		left: -1px;

		width: 1.1em;
		height: 0.7em;
		border-block-end: 1px solid var(--article-heading-color);
		border-inline-start: 1px solid var(--article-heading-color);
	}

	details {
		display: inline;
		margin-inline-start: 0.5em;
	}

	summary {
		cursor: pointer;
		display: inline;
		color: var(--article-heading-color);
		list-style: none;
	}

	summary::-webkit-details-marker {
		display: none;
	}

	summary::before {
		content: '[+] ';
	}

	details[open] > summary::before {
		content: '[-] ';
	}

	time {
		font-size: 13px;
		filter: brightness(60%);
	}
</style>
