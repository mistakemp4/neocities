---
import { getCollection } from 'astro:content';

import Marquee from './Marquee.astro';

const friends = await getCollection('sites', ({ data }) => data.friend);

const secondsPerEntry = 3;
---

<Marquee duration={`${secondsPerEntry * friends.length}s`}>
	{
		friends.map(({ data }) => (
			<li>
				<a href={data.href} rel="noreferrer">
					<img src={data.src} alt={data.alt} width="88" height="31" />
				</a>
			</li>
		))
	}
</Marquee>

<a class="more" href="/library/links/">more links</a>

<style>
	.more {
		display: block;
		margin-top: 8px;
		text-align: center;
	}
</style>
