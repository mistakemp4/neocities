---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

const imports = import.meta.glob<{ default: ImageMetadata }>(
	'/src/assets/blinkers/*',
);
const images = (await Promise.all(Object.values(imports).map(fn => fn()))).map(
	({ default: obj }) => ({ ...obj }),
);
---

<ul>
	{
		images.map(image => (
			<li>
				<Image src={image} alt="Blinker" />
			</li>
		))
	}
</ul>

<style>
	ul {
		display: flex;
		flex-wrap: wrap;

		margin: 0;
		padding: 0;

		list-style-type: none;
	}

	li {
		aspect-ratio: 15 / 2;
	}

	img {
		max-width: 100%;
		max-height: 100%;
	}
</style>
