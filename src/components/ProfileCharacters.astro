import yu from '$/assets/Yu.webp';

// --- Persona 3 ---
import chidori from '$/assets/chidori.webp';
import makoto from '$/assets/makoto.webp';
import yukari from '$/assets/yukari.webp';

// --- Project Sekai (Colorful Stage) ---
import emu from '$/assets/emu.webp';
import ena from '$/assets/ena.webp';
import miku from '$/assets/miku.webp';
import nene from '$/assets/nene.webp';
import rui from '$/assets/rui.webp';
