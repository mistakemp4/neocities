    // --- Cowboy Bebop ---
    { name: 'Edward Wong Hau Pepelu Tivrusky IV', image: edward },
    { name: 'Ein', image: ein },

    // --- Miscellaneous ---
	{ name: 'Ikari Shinji', image: shinji },
	{ name: 'Indou Hikaru', image: hikaru },
