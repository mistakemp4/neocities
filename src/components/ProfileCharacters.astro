import kaidou from '$/assets/kaidou.webp';
import mami from '$/assets/mami.webp';
import megumin from '$/assets/megumin.webp';
import nagatoro from '$/assets/nagatoro.webp';

const characters = [
	// --- Persona 5 ---
	{ name: 'Goro Akechi', image: akechi },
	{ name: 'Sakura Futaba', image: futaba },
	{ name: 'Okumura Haru', image: haru },
	{ name: 'Protagonist (Amamiya Ren)', image: ren },
	{ name: 'Sakamoto Ryuji', image: ryuji },
	{ name: 'Kitagawa Yusuke', image: yusuke },

	// --- Persona 4 ---
	{ name: 'Satonaka Chie', image: chie },
	{ name: 'Shirogane Naoto', image: naoto },
	{ name: 'Hanamura Yosuke', image: yosuke },
	{ name: 'Narukami Yu', image: yu },

	// --- Persona 3 ---
	{ name: 'Yoshino Chidori', image: chidori },
	{ name: 'Yuki Makoto (Protagonist)', image: makoto },
	{ name: 'Takeba Yukari', image: yukari },

	// --- Project Sekai ---
	{ name: 'Otori Emu', image: emu },
	{ name: 'Shinonome Ena', image: ena },
	{ name: 'Hatsune Miku', image: miku },
	{ name: 'Kusanagi Nene', image: nene },
	{ name: 'Kamishiro Rui', image: rui },
	{ name: 'Aoyagi Toya', image: toya },
	{ name: 'Tenma Tsukasa', image: tsukasa },

	// --- Ouran High School Host Club ---
	{ name: 'Fujioka Haruhi', image: haruhi },
	{ name: 'Suoh Tamaki', image: tamaki },

	// --- Miss Kobayashi's Dragon Maid ---
	{ name: 'Kamui Kanna', image: kanna },
	{ name: 'Kobayashi', image: kobayashi },
	{ name: 'Tohru', image: tohru },

	// --- Death Note ---
	{ name: 'L Lawliet', image: l },
	{ name: 'Yagami Light', image: light },

	// --- Cowboy Bebop ---
	{ name: 'Edward Wong Hau Pepelu Tivrusky IV', image: edward },
	{ name: 'Ein', image: ein },

	// --- Miscellaneous ---
	{ name: 'Ikari Shinji', image: shinji },
	{ name: 'Indou Hikaru', image: hikaru },
	{ name: 'Kaidou Shun', image: kaidou },
	{ name: 'Tomoe Mami', image: mami },
	{ name: 'Megumin', image: megumin },
	{ name: 'Nagatoro Hayase', image: nagatoro },
];
---

<ProfileList itemSize={imageSize} {gap}>
	{characters.map(({ name, image }) => <ProfileItem title={name} {image} size={imageSize} />)}
</ProfileList>
